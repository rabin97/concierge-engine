# --- Core ---
APP_ENV=local
DATABASE_URL=postgresql+psycopg://concierge:concierge@localhost:5432/concierge
REDIS_URL=redis://localhost:6379/0
DEFAULT_TIMEZONE=Asia/Kolkata
AWS_REGION=ap-south-1

# --- LLM / embeddings: "fake" runs fully offline; "bedrock" uses Amazon Bedrock ---
LLM_PROVIDER=fake
# Set to a Bedrock model ID (or inference profile ID) enabled in your AWS account
BEDROCK_MODEL_ID=
EMBEDDINGS_PROVIDER=fake
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Notifications: "console" prints to logs; "ses" / "meta" send for real ---
EMAIL_PROVIDER=console
SES_FROM_ADDRESS=no-reply@yourdomain.com
SES_CONFIGURATION_SET=
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=

# --- Vendor (mock vendor runs on :9000 locally) ---
VENDOR_BASE_URL=http://localhost:9000
VENDOR_WEBHOOK_SECRET=dev-vendor-secret
VENDOR_WEBHOOK_URL=http://localhost:8000/v1/webhooks/vendors/mockclean
MOCK_FAIL_FIRST_N=0

# --- Guard (app/agents/guard) ---
# Hashes user IDs and IPs in guard decision logs. Use a long random value from Secrets Manager.
GUARD_HMAC_KEY=
# Empty = app/agents/guard/config/default.yaml (hot-reloaded on change)
GUARD_CONFIG_PATH=
# Ask a Bedrock model about borderline prompts (needs LLM_PROVIDER=bedrock credentials)
GUARD_LLM_JUDGE=false
GUARD_JUDGE_MODEL_ID=
# Optional JSONL files: flagged prompts for human review, hash-chained audit trail
GUARD_REVIEW_QUEUE_PATH=
GUARD_AUDIT_PATH=

# --- Engine tuning ---
SCHEDULER_INTERVAL_SECONDS=1
STEP_LEASE_SECONDS=300
MAX_STEP_ATTEMPTS=5
WHATSAPP_MAX_PER_SECOND=50
EMAIL_MAX_PER_SECOND=14
